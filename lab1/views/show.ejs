<%- include('partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem;"><%= snippet.title %></h1>
    <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; font-size: 0.85rem; color: var(--text-muted);">
      <span class="badge badge-lang"><%= snippet.language %></span>
      
      <% if (snippet.is_unlisted) { %>
        <span class="badge badge-unlisted">Unlisted</span>
      <% } %>

      <% if (snippet.isExpired) { %>
        <span class="badge badge-expired">Expired (<%= snippet.formattedExpires %>)</span>
      <% } else if (snippet.expires_at) { %>
        <span class="badge badge-active">Expires: <%= snippet.formattedExpires %></span>
      <% } else { %>
        <span class="badge badge-neutral">Never Expires</span>
      <% } %>

      <span>• Created: <%= snippet.formattedCreated %></span>
      <span>• Views: <%= snippet.views_count %></span>
      <span>• Lines: <%= snippet.linesCount %></span>
    </div>
  </div>

  <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
    <button onclick="copyShareUrl()" class="btn btn-outline btn-sm" id="copyBtn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      Share Link
    </button>
    
    <a href="/snippets/<%= snippet.id %>/raw" target="_blank" class="btn btn-outline btn-sm">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      Raw Text
    </a>
    
    <form action="/snippets/<%= snippet.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this snippet?');" style="display: inline;">
      <button type="submit" class="btn btn-danger btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
        Delete
      </button>
    </form>
  </div>
</div>

<% if (snippet.isExpired) { %>
  <div class="alert alert-warning">
    This snippet has expired and will be automatically purged during the next cleanup cycle.
  </div>
<% } %>

<% if (snippet.file_path) { %>
  <div class="attachment-card">
    <div class="attachment-info">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
      </svg>
      <div>
        <div style="font-weight: 600; color: var(--text-main); font-size: 0.95rem;"><%= snippet.file_original_name %></div>
        <div style="font-size: 0.8rem; color: var(--text-muted);"><%= snippet.formattedSize %> • <%= snippet.file_mimetype || 'binary file' %></div>
      </div>
    </div>
    <a href="/snippets/<%= snippet.id %>/download" class="btn btn-primary btn-sm">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      Download Attachment
    </a>
  </div>
<% } %>

<div class="code-viewer-wrapper">
  <div class="code-header">
    <div class="code-header-left">
      <span style="font-family: var(--font-mono); font-size: 0.8rem; opacity: 0.8;"><%= snippet.language.toUpperCase() %></span>
    </div>
    <div class="code-header-right">
      <button onclick="copyCode()" class="btn btn-outline btn-sm" id="copyCodeBtn" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        Copy Code
      </button>
    </div>
  </div>
  <pre class="code-block"><code class="hljs language-<%= snippet.language %>"><%- snippet.syntax_highlighted_html %></code></pre>
</div>

<textarea id="rawSnippetText" style="display: none;"><%= snippet.content %></textarea>

<script>
  function copyShareUrl() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      const btn = document.getElementById('copyBtn');
      const originalHTML = btn.innerHTML;
      btn.innerHTML = 'Copied!';
      setTimeout(() => btn.innerHTML = originalHTML, 2000);
    });
  }

  function copyCode() {
    const text = document.getElementById('rawSnippetText').value;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('copyCodeBtn');
      const originalHTML = btn.innerHTML;
      btn.innerHTML = 'Copied!';
      setTimeout(() => btn.innerHTML = originalHTML, 2000);
    });
  }
</script>

<%- include('partials/footer') %>
